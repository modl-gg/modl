# Copy to .env next to docker-compose.yml or modl-server.jar. Commented-out settings use their defaults.
# All variables: https://github.com/modl-gg/modl/wiki/Configuration#environment-variables

# Address the panel is opened at, used in emails and in-game links. Empty: the address you finish setup from.
# MODL_PUBLIC_URL=https://panel.example.com

# Panel port. With Docker, the port published on the host.
MODL_PORT=8080

# Claims the panel for this email: the owner signs in at /setup with the owner sign-in code from the logs.
# Without it, claim the panel with the setup code from the logs.
# MODL_ADMIN_EMAIL=owner@example.com

# Server name. When set, it cannot be changed in the panel.
# MODL_SERVER_NAME=My Server

# Email delivery. When set here, the panel shows it read-only. Without email, login codes are printed in the logs.
# MODL_SMTP_FROM is required unless the username is an email address.
# MODL_SMTP_HOST=smtp.example.com
# MODL_SMTP_PORT=587
# MODL_SMTP_USERNAME=modl@example.com
# MODL_SMTP_PASSWORD=change-me
# MODL_SMTP_FROM=modl@example.com
# MODL_SMTP_STARTTLS=true

# AI moderation. When set here, the panel shows it read-only.
# Providers: openai, anthropic, gemini, openrouter, deepseek, qwen, moonshot, zhipu, minimax, ollama, lm-studio, custom.
# Plain http base URLs work only for local and private addresses. From Docker, the host is host.docker.internal.
# MODL_AI_PROVIDER=
# MODL_AI_API_KEY=
# MODL_AI_MODEL=
# MODL_AI_BASE_URL=
# Used when MODL_AI_API_KEY is empty and the provider is empty or gemini.
# MODL_GEMINI_API_KEY=

# S3-compatible upload storage. Can also be set in Settings > System > Storage; when MODL_STORAGE is set here,
# that page is read-only.
# MODL_STORAGE=s3
# MODL_S3_ENDPOINT=https://s3.example.com
# MODL_S3_REGION=us-east-1
# MODL_S3_BUCKET=modl
# MODL_S3_ACCESS_KEY=
# MODL_S3_SECRET_KEY=
# MODL_S3_PUBLIC_URL=https://files.example.com

# Built-in Cloudflare Tunnel: modl runs cloudflared so the panel needs no open port. Create a tunnel in the Cloudflare
# Zero Trust dashboard with a public hostname pointing at http://localhost:8080, then set its token here and
# MODL_PUBLIC_URL to that https hostname. The panel then listens only inside the container and trusts only the local
# cloudflared.
# MODL_TUNNEL=cloudflare
# MODL_TUNNEL_TOKEN=

# Set true only when every request reaches modl through a reverse proxy or tunnel. MODL_TRUSTED_PROXY=loopback
# trusts forwarded headers only from this machine; private, the default, trusts any private address.
# MODL_TRUST_PROXY_HEADERS=true
# MODL_TRUSTED_PROXY=private

# Upload limits and backups below are also settings in Settings > System > Storage; a value set here wins and locks
# the field. Upload size in MB, total upload storage in GB (0: no limit).
# MODL_MAX_UPLOAD_MB=100
# MODL_IMPORT_MAX_UPLOAD_MB=500
# MODL_MAX_STORAGE_GB=0

# MySQL 8.4+, MariaDB 10.11+ or PostgreSQL 15+ instead of the built-in SQLite. No credentials in the URL.
# MODL_DATABASE_URL=jdbc:postgresql://db.example.com:5432/modl?sslmode=verify-full
# MODL_DATABASE_USERNAME=modl
# MODL_DATABASE_PASSWORD=change-me
# MODL_DATABASE_POOL_SIZE=10

# Folder for the SQLite native library, when the data directory is mounted noexec.
# MODL_SQLITE_NATIVE_DIR=/opt/modl/native

# Days a player's IP is kept after last seen, and days an undelivered player notification is kept.
# Also settings in Settings > System > Data retention.
# MODL_IP_HISTORY_DAYS=365
# MODL_NOTIFICATION_EXPIRY_DAYS=90

# How long an upload that was never submitted is kept, as an ISO 8601 duration.
# MODL_STORAGE_UNATTACHED_UPLOAD_TTL=PT24H

# Nightly SQLite backups kept, and their hour (0 to 23, server time). External databases are not backed up.
# MODL_BACKUP_KEEP=7
# MODL_BACKUP_HOUR=4

# Docker only. Container time zone, which sets the nightly backup hour, such as Europe/Berlin.
# TZ=UTC

# Docker only. Container memory limit, such as 2g; unset means no limit. Java takes up to 75% of it.
# MODL_MEMORY_LIMIT=2g

# Docker only. Image tag; the default follows the patch releases of one MAJOR.MINOR line. To update, set the version and signed
# digest the panel shows, such as 3.0.1@sha256:<digest>. Another MAJOR.MINOR line also needs the plugin updated on
# every server.
# MODL_IMAGE_TAG=3.0

# Updates. MODL_UPDATE_CHECK=false sends no update request. MODL_PRE_UPDATE_BACKUP=false skips the backup before an
# update, so a failed update cannot be undone automatically. MODL_ALLOW_DOWNGRADE=true lets an older modl start on a
# database a newer one used, when the schema did not change. MODL_UPDATE_BASE_URL and MODL_UPDATE_API_URL point at a
# release mirror and its release list.
# MODL_UPDATE_CHECK=true
# MODL_PRE_UPDATE_BACKUP=true
# MODL_ALLOW_DOWNGRADE=false
# MODL_UPDATE_BASE_URL=https://github.com/modl-gg/modl/releases
# MODL_UPDATE_API_URL=https://api.github.com/repos/modl-gg/modl/releases
